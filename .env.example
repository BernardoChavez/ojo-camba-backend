# ==========================================
# OJO CAMBA - Variables de Entorno
# ==========================================

# Configuración del Servidor
PROJECT_NAME="Ojo Camba SCZ Backend"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Base de datos MongoDB
MONGODB_URL="mongodb+srv://<usuario>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="rutavecinal_scz"

# Google Gemini API
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.5-flash"

# Parámetros Anti-Spam y Proximidad (Metros y Minutos)
SPAM_PROXIMITY_METERS=75.0
SPAM_WINDOW_MINUTES=30

# Parámetros de Clustering DBSCAN
DBSCAN_EPS_KM=0.4
DBSCAN_MIN_SAMPLES=3

